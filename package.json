{
  "name": "frontdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Frontdesk - support ticket system for Arvo Systems (PERN)",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "seed:demo": "node server/src/seedDemo.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}